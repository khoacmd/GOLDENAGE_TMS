{
  "expo": {
    "name": "TMS Giao hàng",
    "slug": "tms-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.tms.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.tms.driver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng ghi nhận vị trí khi xác nhận giao hàng."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ứng dụng dùng camera để chụp chứng từ giao nhận.",
          "photosPermission": "Ứng dụng cần truy cập ảnh để đính kèm chứng từ."
        }
      ]
    ]
  }
}
