# Sao chép thành infra/prod/.env rồi điền giá trị thật. KHÔNG commit file .env.
# Tạo bí mật ngẫu nhiên: openssl rand -hex 32

# Tên miền công khai (Caddy tự lấy chứng chỉ HTTPS). Thử trên máy: SITE_ADDRESS=:80, PUBLIC_URL=http://localhost
SITE_ADDRESS=tms.example.com
PUBLIC_URL=https://tms.example.com

# Image (GitHub Container Registry, build bởi workflow "Images")
IMAGE_PREFIX=ghcr.io/khoacmd
TMS_VERSION=latest

# Nơi lưu dữ liệu trên máy chủ (postgres, redis, ảnh, bản đồ, osrm, backup)
DATA_DIR=/srv/tms

POSTGRES_PASSWORD=
TMS_OWNER_PASSWORD=
TMS_APP_PASSWORD=
TMS_JWT_SECRET=
S3_ACCESS_KEY=tms
S3_SECRET_KEY=
TMS_S3_BUCKET=tms-photos

# Giám sát (tùy chọn)
TMS_SENTRY_DSN=
TMS_SENTRY_TRACES_SAMPLE_RATE=0

# Định tuyến OSRM: bật profile "routing" sau khi dựng dữ liệu vào $DATA_DIR/osrm
# (COMPOSE_PROFILES=routing). Để trống URL → khoảng cách ước lượng.
COMPOSE_PROFILES=
TMS_OSRM_CAR_URL=
TMS_OSRM_MOTORBIKE_URL=

# Số bản backup giữ lại (mỗi ngày 1 bản)
BACKUP_KEEP_DAYS=14
